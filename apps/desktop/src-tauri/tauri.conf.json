{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RambleDesk",
  "version": "0.3.0-rc.2",
  "identifier": "io.rambledesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "RambleDesk",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "acceptFirstMouse": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../packages/pi-rambledesk/index.js": "pi-rambledesk/index.js",
      "../../../packages/pi-rambledesk/package.json": "pi-rambledesk/package.json",
      "../../../packages/pi-rambledesk/README.md": "pi-rambledesk/README.md",
      "../../../packages/dsh-rambledesk/index.js": "dsh-rambledesk/index.js",
      "../../../packages/dsh-rambledesk/package.json": "dsh-rambledesk/package.json",
      "../../../packages/dsh-rambledesk/README.md": "dsh-rambledesk/README.md",
      "../../../packages/dsh-rambledesk/skills/ramble/SKILL.md": "dsh-rambledesk/skills/ramble/SKILL.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "l1veIn",
    "category": "DeveloperTool",
    "shortDescription": "A workbench that takes rambling for coding agents.",
    "longDescription": "RambleDesk turns messy speech, screenshots, and notes into a feedback package the agent can continue from.",
    "copyright": "Copyright © 2026 l1veIn",
    "windows": {
      "nsis": {
        "template": "installer/rambledesk-installer.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NUYwNEI1ODVFQzI2RDkKUldUWkp1eUZ0UVJmZGZYSUQwTXRqWlQ0dEFLTkRMNTFld21Zb05UVmRUZ3hxK1dXYTZsaGU5b3kK",
      "endpoints": [
        "https://github.com/l1veIn/rambledesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
