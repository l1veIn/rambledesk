{
  "name": "rambledesk",
  "private": true,
  "version": "0.0.2-rc.1",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm -C apps/desktop tauri dev",
    "dev:web": "pnpm -C apps/desktop dev:web",
    "build": "pnpm -C apps/desktop tauri build",
    "build:web": "pnpm -C apps/desktop build:web",
    "check": "pnpm -C apps/desktop check",
    "test": "pnpm -C apps/desktop test",
    "test:pi": "pnpm -C packages/pi-rambledesk test",
    "test:rust": "cargo test --workspace",
    "check:rust-size": "node scripts/check-rust-module-size.mjs",
    "check:terminology": "node scripts/check-terminology.mjs",
    "contracts:generate": "cargo run -p rambledesk-core --example export_types",
    "contracts:check": "node scripts/contracts-check.mjs",
    "mcp:self-test": "cargo run -p rambledesk-cli -- self-test",
    "mcp:inspector-smoke": "scripts/mcp-inspector-smoke.sh",
    "format:check": "cargo fmt --all --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "release:check": "node scripts/check-release-version.mjs"
  }
}
