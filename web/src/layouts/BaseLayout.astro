---
import '../styles/global.css'
interface Props { title: string; description: string; lang: string }
const { title, description, lang } = Astro.props
const origin = 'https://www.rambledesk.com'
const canonical = new URL(lang === 'zh-CN' ? '/zh/' : '/', origin).href
const shareImage = `${origin}/assets/refresh/hero-desktop.webp`
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9fc" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${origin}/`} />
    <link rel="alternate" hreflang="zh-CN" href={`${origin}/zh/`} />
    <link rel="alternate" hreflang="x-default" href={`${origin}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RambleDesk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh-CN' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1600" />
    <meta property="og:image:alt" content="Rambelle, RambleDesk's archivist, handing you a glass folio." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/assets/refresh/rambledesk-mark.svg" />
  </head>
  <body><slot /></body>
</html>
