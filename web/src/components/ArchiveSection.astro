---
import type { SiteContent } from '../content/site'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<section class="archive-section" id="adapters" aria-label={content.archive.kicker}>
  <video
    class="archive-video"
    src="/assets/archive-vault.mp4"
    autoplay
    muted
    playsinline
    aria-hidden="true"
  ></video>
  <div class="archive-veil" aria-hidden="true"></div>
  <div class="archive-inner">
    <div class="archive-copy">
      <span class="section-kicker">{content.archive.kicker}</span>
      <h2>{content.archive.title}</h2>
      <p>{content.archive.sub}</p>
    </div>

    <div class="archive-timeline" aria-label={content.archive.title}>
      <div class="archive-rail" aria-hidden="true">
        <span></span>
      </div>
      {content.archive.packages.map((pkg, index) => (
        <article class="archive-package" style={`--i: ${index}`}>
          <span class="archive-node" aria-hidden="true"></span>
          <div class="archive-card">
            <span class="archive-hash">{pkg.hash}</span>
            <strong>{pkg.title}</strong>
            <div class="archive-meta">
              <time>{pkg.date}</time>
              <span class="archive-state">
                <i></i>
                {pkg.state}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="archive-footer">
      <p>{content.archive.adapterNote}</p>
      <div class="archive-chips">
        {content.adapters.map((adapter) => (
          <span>{adapter}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Seamless ken-burns playback: play forward, ease at the end, then play
  // backwards in the same motion — no loop jump.
  const vid = document.querySelector<HTMLVideoElement>('.archive-video')
  if (vid && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let start: number | null = null
    const drive = (ts: number) => {
      if (!document.hidden) {
        if (start === null) start = ts
        const dur = vid.duration
        if (dur > 0) {
          // constant-speed pingpong: 0 -> dur -> 0 -> dur ..., no easing
          const half = dur * 1000
          const p = ((ts - start) % (half * 2)) / half
          vid.currentTime = p < 1 ? dur * p : dur * (2 - p)
        }
      }
      requestAnimationFrame(drive)
    }
    requestAnimationFrame(drive)
  }
</script>
