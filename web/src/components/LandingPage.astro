---
import HeroStage from './HeroStage.svelte'
import HappyPathStage from './lens2/HappyPathStage.svelte'
import ArchiveSection from './ArchiveSection.astro'
import PostureSection from './PostureSection.astro'
import { assets, releaseUrl, repoUrl, type SiteContent } from '../content/site'

interface Props {
  content: SiteContent
}

const { content } = Astro.props
---

<div class="site-shell">
  <div class="global-field" aria-hidden="true">
    <span class="global-grid"></span>
    <span class="global-spine"></span>
    <span class="global-scan"></span>
  </div>

  <header class="site-nav">
    <a class="brand-lockup" href={content.path} aria-label="RambleDesk home">
      <img src="/assets/rambledesk-app-icon.webp" alt="" />
      <span>RambleDesk</span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#product">{content.nav.product}</a>
      <a href="#loop">{content.nav.loop}</a>
      <a href="#adapters">{content.nav.adapters}</a>
      <a href={content.alternatePath}>{content.alternateLabel}</a>
    </nav>
    <a class="nav-download" href={repoUrl} aria-label="GitHub">
      <svg class="gh-mark" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path
          d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"
        ></path>
      </svg>
      <span>GitHub</span>
    </a>
  </header>

  <main>
    <HeroStage hero={content.hero} assets={assets} releaseUrl={releaseUrl} />

    <PostureSection content={content} />

    <HappyPathStage client:load content={content.lens2} />

    <ArchiveSection content={content} />

    <section class="final-cta">
      <div class="cta-bg" style={`background-image: url(${assets.sceneGate})`}></div>
      <div class="cta-content">
        <span class="section-kicker">{content.vision.kicker}</span>
        <h2>{content.vision.headline}</h2>
        <div class="vision-slogan">{content.vision.slogan}</div>
        <div class="vision-evolution">
          <div class="vision-row vision-before">
            <span class="vision-label">{content.vision.beforeLabel}</span>
            <strong>{content.vision.before}</strong>
          </div>
          <div class="vision-row vision-after">
            <span class="vision-label">{content.vision.afterLabel}</span>
            <strong>{content.vision.after}</strong>
          </div>
        </div>
        <p class="vision-philosophy">{content.vision.philosophy}</p>
        <a class="primary-action" href={releaseUrl}>
          {content.vision.ctaLabel}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <small class="vision-meta">{content.vision.meta}</small>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>RambleDesk</span>
    <a href={repoUrl}>GitHub</a>
    <a href={content.alternatePath}>{content.alternateLabel}</a>
  </footer>
</div>
