---
import WorkbenchDemos from './WorkbenchDemos.svelte'
import { links, release, repoUrl, type SiteContent } from '../content/site'
interface Props { content: SiteContent }
const { content: c } = Astro.props
---
<a class="skip-link" href="#main">{c.skip}</a>
<header class="site-nav">
  <div class="nav-inner container">
    <a class="brand" href={c.path} aria-label="RambleDesk">
      <img src="/assets/refresh/rambledesk-mark.svg" width="36" height="36" alt="" />
      <span>RambleDesk</span>
    </a>
    <nav class="desktop-nav" aria-label={c.nav.label}>
      <a href="#demo">{c.nav.workflow}</a>
      <a href="#start">{c.nav.start}</a>
      <a href={repoUrl}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="nav-actions">
      <a class="language-link" href={c.alternatePath} hreflang={c.lang === 'en' ? 'zh-CN' : 'en'} aria-label={c.nav.language}>{c.alternateLabel}</a>
      <a class="button button-small nav-cta" href="#download">{c.nav.download}<span aria-hidden="true">↓</span></a>
      <details class="mobile-menu">
        <summary aria-label={c.nav.menu}><span></span><span></span></summary>
        <nav aria-label={c.nav.label}>
          <a href="#demo">{c.nav.workflow}</a><a href="#start">{c.nav.start}</a>
          <a href="#download">{c.nav.download}</a><a href={repoUrl}>GitHub ↗</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero-art">
      <source media="(max-width: 960px)" srcset="/assets/refresh/hero-mobile.webp" width="1024" height="1024" />
      <img src="/assets/refresh/hero-desktop.webp" width="2560" height="1600" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-hex" aria-hidden="true"></span>{c.hero.eyebrow}</p>
        <h1 id="hero-title">{c.hero.lines.map(line => <span>{line}</span>)}</h1>
        <p class="hero-body">{c.hero.body}</p>
        <div class="hero-actions">
          <a class="button" href="#download">{c.hero.download}<span aria-hidden="true">↓</span></a>
          <a class="button button-outline" href="#demo"><span class="play-icon" aria-hidden="true">▷</span>{c.hero.watch}</a>
        </div>
        <p class="platform-note">{c.hero.platforms}</p>
      </div>
      <div class="hero-footnote" aria-hidden="true"><span>RAMBLEDESK / 01</span><span>{c.hero.footnote}</span><span>↓</span></div>
    </div>
  </section>

  <section class="workflow-section section-space" id="workflow" aria-labelledby="workflow-title">
    <div class="container">
      <div class="section-copy">
        <p class="section-label">{c.workflow.label}</p>
        <h2 id="workflow-title">{c.workflow.title}</h2>
        <p>{c.workflow.body}</p>
      </div>
      <ol class="workflow-steps">
        {c.workflow.steps.map((step, i) => <li data-reveal><span class="workflow-index">0{i + 1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="demo-section section-space" id="demo" aria-labelledby="demo-title">
    <div class="container">
      <div class="demo-heading">
        <p class="section-label">{c.workbenches.label}</p>
        <h2 id="demo-title">{c.workbenches.title}</h2><p>{c.workbenches.body}</p>
      </div>
      <WorkbenchDemos client:visible content={c.workbenches} lang={c.lang} />
      <p class="preview-note">{c.workbenches.previewNote}</p>
      <div class="workbench-catalog">
        <h3>{c.workbenches.catalogTitle}</h3>
        <ul>{c.workbenches.catalog.map(item => <li>{item.name}{item.development && <small>{c.workbenches.developmentLabel}</small>}</li>)}</ul>
        <p>{c.workbenches.note}</p>
        <div class="catalog-links">{c.workbenches.references.map(item => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}</div>
      </div>
    </div>
  </section>

  <section class="start-section section-space" id="start" aria-labelledby="start-title">
    <div class="container">
      <p class="section-label">{c.start.label}</p>
      <h2 id="start-title">{c.start.title}</h2><p class="start-intro">{c.start.body}</p>
      <ul class="agent-names" aria-label="Agents"><li>Claude Code</li><li>Codex CLI</li><li>Gemini CLI</li></ul>
      <ol class="start-steps">
        {c.start.steps.map((step, i) => <li><span class="step-index">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}
      </ol>
      <div class="start-resources"><div class="resource-links"><a href={links.acp}>{c.start.acp}<span aria-hidden="true">↗</span></a><a href={links.adapters}>{c.start.adapters}<span aria-hidden="true">↗</span></a></div><p>{c.start.note}</p></div>
    </div>
  </section>

  <section class="download-section" id="download" aria-labelledby="download-title">
    <img class="closing-art" src="/assets/refresh/closing.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="" />
    <div class="container download-inner">
      <div class="download-copy">
        <p class="section-label">{c.download.label}</p>
        <h2 id="download-title">{c.download.title}</h2>
        <p class="privacy-copy">{c.download.privacy}</p>
        <div class="download-buttons">
          <a class="button platform-button" href={release.mac}><span>{c.download.mac}<small>Apple Silicon · .dmg</small></span><span aria-hidden="true">↓</span></a>
          <a class="button button-outline platform-button" href={release.windows}><span>{c.download.windows}<small>x64 · .exe</small></span><span aria-hidden="true">↓</span></a>
        </div>
        <p class="release-meta"><span>v{release.version} · {c.download.candidate}</span><a href={release.url}>{c.download.releaseNotes} ↗</a></p>
        <p class="upgrade-note">{c.download.upgrade} <a href={links.compatibility}>{c.download.upgradeGuide} ↗</a></p>
      </div>
    </div>
  </section>
  <div class="installation-section">
    <div class="container">
      <details class="installation-details">
        <summary>{c.download.installation}<span aria-hidden="true">+</span></summary>
        <div class="installation-grid">
          <div><h3>macOS</h3><p>{c.download.macNote}</p></div>
          <div><h3>Windows</h3><p>{c.download.windowsNote}</p></div>
          <div><h3>{c.download.voiceTitle}</h3><p>{c.download.voiceNote}</p></div>
          <div><h3>{c.download.organizeTitle}</h3><p>{c.download.organizeNote}</p></div>
        </div>
        <a class="installation-guide" href={c.lang === 'zh-CN' ? links.installationZh : links.installation}>{c.download.installation} ↗</a>
      </details>
    </div>
  </div>
</main>
<footer class="site-footer">
  <div class="footer-inner container">
    <a class="brand" href={c.path}><img src="/assets/refresh/rambledesk-mark.svg" width="30" height="30" alt=""/><span>RambleDesk</span></a>
    <span class="footer-signature">{c.footer.signature}</span>
    <nav aria-label={c.lang === 'en' ? 'Footer' : '页脚'}><a href={repoUrl}>GitHub</a><a href={c.lang === 'zh-CN' ? links.docsZh : links.docs}>{c.footer.docs}</a><a href={links.license}>{c.footer.license}</a><a href={c.alternatePath}>{c.alternateLabel}</a></nav>
  </div>
</footer>
<script>
  const header = document.querySelector<HTMLElement>('.site-nav')
  const hero = document.querySelector('.hero')
  if (header && hero) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('scrolled', !entry.isIntersecting)
    }, { rootMargin: '-72px 0px 0px 0px' }).observe(hero)
  }
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu')
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false }))
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus() }
  })
  document.addEventListener('click', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false
  })
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)')
  if (!motion.matches) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue
        if (motion.matches) { observer.unobserve(entry.target); continue }
        entry.target.animate([{ transform: 'translateY(10px)' }, { transform: 'translateY(0)' }], { duration: 280, easing: 'ease-out' })
        observer.unobserve(entry.target)
      }
    }, { threshold: 0.15 })
    document.querySelectorAll('[data-reveal]').forEach(element => observer.observe(element))
  }
</script>
